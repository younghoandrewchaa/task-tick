{
  "name": "tasktick",
  "productName": "TaskTick",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet place for your tasks and focused time.",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/*.test.js",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.6",
    "electron": "^45.2.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
